	<ItemGroup>
		<Folder Include="Components\Display\" />
	</ItemGroup>

	<!-- ============ Local deploy for F5 debugging ==================
	     Replaces the old duplicated PostBuild targets and deploy.ps1.
	     Two targets with the same Name silently override each other, so
	     these are distinctly named and OS-conditioned.
	     ContinueOnError: never fail a build (or CI) just because Rhino
	     is not installed on the machine. -->
	<Target Name="DeployToGrasshopperWindows" AfterTargets="Build"
	        Condition="'$(OS)' == 'Windows_NT'">
		<Copy SourceFiles="$(TargetPath)"
		      DestinationFolder="$(AppData)\Grasshopper\Libraries"
		      ContinueOnError="true" />
	</Target>

	<Target Name="DeployToGrasshopperMac" AfterTargets="Build"
	        Condition="'$(OS)' != 'Windows_NT'">
		<Copy SourceFiles="$(TargetPath)"
		      DestinationFolder="$(HOME)/Library/Application Support/McNeel/Rhinoceros/8.0/Plug-ins/Grasshopper (b45a29b1-4343-4035-989e-044e8580d9cf)/Libraries"
		      ContinueOnError="true" />
	</Target>

</Project>
