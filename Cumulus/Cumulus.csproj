<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>

		<!-- AnyCPU is mandatory: one assembly must load on Windows x64,
		     Intel Mac, and Apple Silicon. Never add x64 or arm64. -->
		<PlatformTarget>AnyCPU</PlatformTarget>
		<Platforms>AnyCPU</Platforms>
		<BaseOutputPath>bin\</BaseOutputPath>
		<BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
		<EnableDynamicLoading>true</EnableDynamicLoading>

		<!-- Build a .gha directly instead of producing a .dll and renaming it
		     in a post-build step. -->
		<TargetExt>.gha</TargetExt>

		<LangVersion>latest</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

		<!-- RENAMED from SpatialMorphology. RootNamespace also drives the
		     manifest names of every EmbeddedResource below, so the icon
		     lookup strings in code must read Cumulus.Resources.X_24.png.
		     A mismatch here does NOT fail the build - the Icon getter just
		     returns null and the ribbon shows a blank component. -->
		<AssemblyName>Cumulus</AssemblyName>
		<RootNamespace>Cumulus</RootNamespace>

		<!-- CS1591: missing XML comment. Turn off until docs are written. -->
		<NoWarn>NU1701;CS1591</NoWarn>
	</PropertyGroup>

	<!-- Guard: WPF/WinForms silently break macOS. Fail the build if reintroduced. -->
	<Target Name="FailOnWindowsOnlyUI" BeforeTargets="Build" Condition="'$(UseWPF)' == 'true' or '$(UseWindowsForms)' == 'true'">
		<Error Text="UseWPF/UseWindowsForms are not permitted: they break macOS. Use Eto.Forms." />
	</Target>

	<!-- ============ Package references ============================
	     ExcludeAssets="runtime" + PrivateAssets="all" are BOTH required.
	     Rhino supplies these assemblies at runtime; copying them next to
	     the .gha causes assembly-identity conflicts and load failures.

	     Eto.Forms is pinned to 2.11.0 to match what RhinoCommon 8.31
	     expects. 2.12.0 produces CS0012 on Eto.Forms.Window. -->
	<ItemGroup>
		<PackageReference Include="Eto.Forms" Version="2.11.0" />
		<PackageReference Include="Grasshopper" Version="8.31.26126.13431" ExcludeAssets="runtime" PrivateAssets="all" />
		<PackageReference Include="RhinoCommon" Version="8.31.26126.13431" ExcludeAssets="runtime" PrivateAssets="all" />
		<ProjectReference Include="..\Cumulus.Core\Cumulus.Core.csproj" />
	</ItemGroup>

	<!-- ============ Embedded icons ================================
	     Both lists must stay in sync with the actual .png files on disk.
	     The SA_* entries from the pre-rename era have been removed. -->
	<ItemGroup>
		<None Remove="Resources\AnalysisStack_24.png" />
		<None Remove="Resources\Composite_24.png" />
		<None Remove="Resources\CoreLocation_24.png" />
		<None Remove="Resources\FloorLevel_24.png" />
		<None Remove="Resources\Merge_24.png" />
		<None Remove="Resources\NeighborCount_24.png" />
		<None Remove="Resources\NormalizeValues_24.png" />
		<None Remove="Resources\Orientation_24.png" />
		<None Remove="Resources\ProgramDefinition_24.png" />
		<None Remove="Resources\Proximity_24.png" />
		<None Remove="Resources\Solar_24.png" />
		<None Remove="Resources\SunVectors_24.png" />
		<None Remove="Resources\SurfaceDistance_24.png" />
		<None Remove="Resources\ValueSet_24.png" />
		<None Remove="Resources\View_24.png" />
		<None Remove="Resources\Visibility_24.png" />
		<None Remove="Resources\VoxelGrid_24.png" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Resources\AnalysisStack_24.png" />
		<EmbeddedResource Include="Resources\Composite_24.png" />
		<EmbeddedResource Include="Resources\CoreLocation_24.png" />
		<EmbeddedResource Include="Resources\FloorLevel_24.png" />
		<EmbeddedResource Include="Resources\Merge_24.png" />
		<EmbeddedResource Include="Resources\NeighborCount_24.png" />
		<EmbeddedResource Include="Resources\NormalizeValues_24.png" />
		<EmbeddedResource Include="Resources\Orientation_24.png" />
		<EmbeddedResource Include="Resources\ProgramDefinition_24.png" />
		<EmbeddedResource Include="Resources\Proximity_24.png" />
		<EmbeddedResource Include="Resources\Solar_24.png" />
		<EmbeddedResource Include="Resources\SunVectors_24.png" />
		<EmbeddedResource Include="Resources\SurfaceDistance_24.png" />
		<EmbeddedResource Include="Resources\ValueSet_24.png" />
		<EmbeddedResource Include="Resources\View_24.png" />
		<EmbeddedResource Include="Resources\Visibility_24.png" />
		<EmbeddedResource Include="Resources\VoxelGrid_24.png" />
	</ItemGroup>

	<ItemGroup>
		<Folder Include="Components\Display\" />
	</ItemGroup>

	<!-- Files that must travel together into the Libraries folder.
	     The .gha alone is not enough once it references Core. -->
	<ItemGroup>
		<GhaDeployFiles Include="$(TargetPath)" />
		<GhaDeployFiles Include="$(TargetDir)Cumulus.Core.dll" />
	</ItemGroup>

	<!-- ContinueOnError is deliberately NOT set on either target.
	     Rhino locks the deployed .gha while running, and swallowing that
	     failure produces a build that reports success while deploying
	     nothing - which looks identical to a code change not working. -->
	<Target Name="DeployToGrasshopperWindows" AfterTargets="Build" Condition="'$(OS)' == 'Windows_NT'">
		<Copy SourceFiles="@(GhaDeployFiles)" DestinationFolder="$(AppData)\Grasshopper\Libraries" />
	</Target>

	<Target Name="DeployToGrasshopperMac" AfterTargets="Build" Condition="'$(OS)' != 'Windows_NT'">
		<Copy SourceFiles="@(GhaDeployFiles)" DestinationFolder="$(HOME)/Library/Application Support/McNeel/Rhinoceros/8.0/Plug-ins/Grasshopper (b45a29b1-4343-4035-989e-044e8580d9cf)/Libraries" />
	</Target>

</Project>
